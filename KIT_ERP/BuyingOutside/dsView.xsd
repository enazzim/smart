<?xml version="1.0" standalone="yes"?>
<xs:schema id="dsView" targetNamespace="http://www.tempuri.org/dsView.xsd" xmlns:mstns="http://www.tempuri.org/dsView.xsd" xmlns="http://www.tempuri.org/dsView.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="dsView" msdata:IsDataSet="true" msdata:Locale="ko-KR">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="TempTable">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ProcessSequenceNum" type="xs:unsignedByte" minOccurs="0" />
              <xs:element name="ProcessCode" type="xs:string" minOccurs="0" />
              <xs:element name="ProcessName" type="xs:string" minOccurs="0" />
              <xs:element name="ItemNum" type="xs:string" minOccurs="0" />
              <xs:element name="ItemDrawNum" type="xs:string" minOccurs="0" />
              <xs:element name="ItemName" type="xs:string" minOccurs="0" />
              <xs:element name="Lavel" type="xs:int" minOccurs="0" />
              <xs:element name="Index" msdata:ReadOnly="true" msdata:AutoIncrement="true" type="xs:int" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="Constraint1" msdata:PrimaryKey="true">
      <xs:selector xpath=".//mstns:TempTable" />
      <xs:field xpath="mstns:Index" />
    </xs:unique>
  </xs:element>
</xs:schema>