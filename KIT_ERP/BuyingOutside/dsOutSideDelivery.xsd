							<xs:element name="ThirdDeliveryDemandDate" type="xs:dateTime" minOccurs="0" />
							<xs:element name="FourthDeliveryDemandQuantity" type="xs:decimal" minOccurs="0" />
							<xs:element name="FourthDeliveryDemandDate" type="xs:dateTime" minOccurs="0" />
							<xs:element name="FifthDeliveryDemandQuantity" type="xs:decimal" minOccurs="0" />
							<xs:element name="FifthDeliveryDemandDate" type="xs:dateTime" minOccurs="0" />
							<xs:element name="OrderQuantity" type="xs:decimal" minOccurs="0" />
							<xs:element name="ApplyUnitCost" type="xs:decimal" minOccurs="0" />
							<xs:element name="TotalCost" type="xs:decimal" minOccurs="0" />
							<xs:element name="RemainQuantity" type="xs:decimal" minOccurs="0" />
