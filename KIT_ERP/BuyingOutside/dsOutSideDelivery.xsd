		<xs:unique name="OO_HT_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
			<xs:selector xpath=".//mstns:OO_HT" />
			<xs:field xpath="mstns:OutSideOrderHistoryIndex" />
