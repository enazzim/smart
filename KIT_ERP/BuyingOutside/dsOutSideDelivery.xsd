<?xml version="1.0" standalone="yes" ?>
<xs:schema id="dsOutSideDelivery" targetNamespace="http://www.tempuri.org/dsOutSideDelivery.xsd"
	xmlns:mstns="http://www.tempuri.org/dsOutSideDelivery.xsd" xmlns="http://www.tempuri.org/dsOutSideDelivery.xsd"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
	attributeFormDefault="qualified" elementFormDefault="qualified">
	<xs:element name="dsOutSideDelivery" msdata:IsDataSet="true" msdata:Locale="ko-KR">
		<xs:complexType>
