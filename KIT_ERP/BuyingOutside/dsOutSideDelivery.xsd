							<xs:element name="UpdatingDate" type="xs:dateTime" minOccurs="0" />
							<xs:element name="OutSideOrderRequestHistoryIndex" type="xs:int" minOccurs="0" />
							<xs:element name="OutSideOrderHistoryIndex" msdata:ReadOnly="true" msdata:AutoIncrement="true"
								type="xs:int" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
