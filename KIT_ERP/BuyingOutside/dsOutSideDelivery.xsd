							<xs:element name="BusinessRegistrationNum" type="xs:string" minOccurs="0" />
							<xs:element name="OrderRate" type="xs:decimal" minOccurs="0" />
							<xs:element name="FirstDeliveryDemandQuantity" type="xs:decimal" minOccurs="0" />
