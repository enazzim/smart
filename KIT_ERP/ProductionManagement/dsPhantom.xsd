<?xml version="1.0" standalone="yes"?>
<xs:schema id="dsPhantom" targetNamespace="http://www.tempuri.org/dsPhantom.xsd" xmlns:mstns="http://www.tempuri.org/dsPhantom.xsd" xmlns="http://www.tempuri.org/dsPhantom.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="dsPhantom" msdata:IsDataSet="true" msdata:Locale="ko-KR">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="ItemGroup_HT">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ItemGroup" type="xs:string" minOccurs="0" />
              <xs:element name="ReceivingOrderDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="DeliveryDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="Quantity" type="xs:decimal" minOccurs="0" />
              <xs:element name="ProgressCondition" type="xs:string" minOccurs="0" />
              <xs:element name="ItemGroupIndex" msdata:ReadOnly="true" msdata:AutoIncrement="true" type="xs:int" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="Constraint1" msdata:PrimaryKey="true">
      <xs:selector xpath=".//mstns:ItemGroup_HT" />
      <xs:field xpath="mstns:ItemGroupIndex" />
    </xs:unique>
  </xs:element>
</xs:schema>