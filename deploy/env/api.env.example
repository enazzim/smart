# /etc/smartmanager/api.env 로 복사 후 값을 채운다.
# sudo chmod 600 /etc/smartmanager/api.env
# sudo chown root:smartmanager /etc/smartmanager/api.env
#
# 이 파일은 예시이며 실제 비밀번호를 git에 커밋하지 않는다.

SPRING_PROFILES_ACTIVE=prod

SMARTMANAGER_DB_URL=jdbc:mariadb://localhost:3306/smartmanager?characterEncoding=utf8mb4&serverTimezone=Asia/Seoul
SMARTMANAGER_DB_USER=smartmanager
SMARTMANAGER_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

SMARTMANAGER_JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
SMARTMANAGER_JWT_EXPIRATION_MINUTES=480

SMARTMANAGER_ADMIN_LOGIN_ID=admin
SMARTMANAGER_ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SMARTMANAGER_ADMIN_SEED_ENABLED=true

SMARTMANAGER_DRAWING_STORAGE_DIR=/var/smartmanager/drawing-storage/pdf
SMARTMANAGER_BOARD_FILES_DIR=/var/smartmanager/filedownload
SMARTMANAGER_BACKUP_DIR=/var/smartmanager/backup
